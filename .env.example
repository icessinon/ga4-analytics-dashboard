# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ga4_dashboard

# Redis
REDIS_URL=redis://localhost:6380

# AI API
GEMINI_API_KEY=your_gemini_api_key

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Basic認証（未設定時はログイン不可）
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=your_secure_password

INTERNAL_API_SECRET=your_internal_secret

# アプリの公開URL（Slack の「詳細を見る」リンクなど。開発 Docker は 3003、本番は https://ドメイン）
NODE_ENV=development
APP_URL=http://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3003

# BigQuery (hrs-div.ga4_analytics_dashboard へ実行履歴を積む)
# SA の JSON 文字列 (rawJson) をそのまま入れる。ai-tools-dashboard と共通の SA でOK
# hrs-div.ga4_analytics_dashboard に dataEditor 権限が必要
# 統合サービスアカウント (ga4-analytics-dashboard@xmile-drm)
# BigQuery(xmile-drm) / GA4 Data API(property 534098180) / Search Console(sc-domain:x-work.jp)
# の全てをこの1本で賄う。JSONを1行で入れるか、KEY_PATH でファイルを指す（どちらか一方）
GCP_SERVICE_ACCOUNT_KEY=
GCP_SERVICE_ACCOUNT_KEY_PATH=

# 以下は移行期のフォールバック用。全環境が GCP_SERVICE_ACCOUNT_KEY* に移ったら削除してよい
# GA4_SERVICE_ACCOUNT_KEY / GA4_SERVICE_ACCOUNT_KEY_PATH  … 旧GA4用SA
# BQ_WRITE_SERVICE_ACCOUNT_KEY                            … 旧Search Console/BQ書き込み用SA
BQ_WRITE_SERVICE_ACCOUNT_KEY=

# Notion 施策カード連携（AB最終レポートの企画背景取り込み用）
# Notion内部インテグレーションのトークン。「課題・施策アイディア」DBを当該インテグレーションに共有すること。
# 未設定なら Notion 参照は自動でスキップ（従来通り数値のみでレポート生成）
NOTION_API_KEY=
